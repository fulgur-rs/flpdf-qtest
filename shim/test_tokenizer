#!/usr/bin/env bash
#
# shim/test_tokenizer — route qpdf's tokenizer helper name to the Rust
# qpdf/test_tokenizer.cc port in flpdf-qtest-tools.
#
# Required env:
#   FLPDF_TEST_TOKENIZER_BIN — absolute path to flpdf-test-tokenizer.

set -u

if [[ -z "${FLPDF_TEST_TOKENIZER_BIN:-}" ]]; then
    echo "shim/test_tokenizer: FLPDF_TEST_TOKENIZER_BIN is not set" >&2
    exit 127
fi

if [[ ! -x "${FLPDF_TEST_TOKENIZER_BIN}" ]]; then
    echo "shim/test_tokenizer: FLPDF_TEST_TOKENIZER_BIN=${FLPDF_TEST_TOKENIZER_BIN} is not executable" >&2
    exit 127
fi

exec -a test_tokenizer "${FLPDF_TEST_TOKENIZER_BIN}" "$@"
