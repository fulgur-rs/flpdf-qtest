#!/usr/bin/env bash
#
# shim/test_pdf_unicode — route qpdf's historical character-encoding helper
# name to flpdf-test-pdf-unicode.

set -u

if [[ -z "${FLPDF_TEST_PDF_UNICODE_BIN:-}" ]]; then
    echo "shim/test_pdf_unicode: FLPDF_TEST_PDF_UNICODE_BIN is not set" >&2
    exit 127
fi

if [[ ! -x "${FLPDF_TEST_PDF_UNICODE_BIN}" ]]; then
    echo "shim/test_pdf_unicode: FLPDF_TEST_PDF_UNICODE_BIN=${FLPDF_TEST_PDF_UNICODE_BIN} is not executable" >&2
    exit 127
fi

if [[ -n "${FLPDF_QTEST_NORMALIZE:-}" && -r "${FLPDF_QTEST_NORMALIZE}" ]]; then
    exec -a test_pdf_unicode \
        "${FLPDF_TEST_PDF_UNICODE_BIN}" "$@" \
        2> >(sed -f "${FLPDF_QTEST_NORMALIZE}" 1>&2)
fi

exec -a test_pdf_unicode "${FLPDF_TEST_PDF_UNICODE_BIN}" "$@"
