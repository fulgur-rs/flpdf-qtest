#!/usr/bin/env bash
#
# shim/qpdf — placed on PATH ahead of any real qpdf so that .test files
# invoking `qpdf ...` are routed to flpdf-cli.
#
# Required env:
#   FLPDF_CLI_BIN  — absolute path to the flpdf-cli binary to delegate to.
#
# Optional env:
#   FLPDF_QPDF_COMPAT      — when "1", forwarded as-is (flpdf-cli reads it to
#                            enable qpdf-compatible CLI parsing).
#   FLPDF_QTEST_NORMALIZE  — when set to a sed script path, flpdf-cli's
#                            diagnostics are filtered through it to absorb
#                            "flpdf:" → "qpdf:" prefix differences.
#
#                            Which stream is filtered depends on where the two
#                            descriptors point, because qtest reads both:
#
#                            * Same destination (TestDriver's default capture
#                              does `exec 2>&1`): filter the single merged
#                              stream, so the interleaved write order the
#                              fixtures record is reproduced exactly.
#                            * Distinct destinations (a .test redirecting
#                              stdout, e.g. `qpdf --progress in.pdf - > b.pdf`):
#                              filter stderr only. Merging there would write
#                              diagnostics into the payload file and strip them
#                              from the captured stream. stdout is left byte
#                              for byte as flpdf-cli wrote it.

set -u

if [[ -z "${FLPDF_CLI_BIN:-}" ]]; then
    echo "shim/qpdf: FLPDF_CLI_BIN is not set" >&2
    exit 127
fi

if [[ ! -x "${FLPDF_CLI_BIN}" ]]; then
    echo "shim/qpdf: FLPDF_CLI_BIN=${FLPDF_CLI_BIN} is not executable" >&2
    exit 127
fi

# The delegated binary is flpdf-cli, but this process is the qpdf command
# surface. Preserve an explicit override for focused probes while giving the
# Rust QPDFJob the same default prefix as qpdf 11.9.0.
export FLPDF_PROGNAME="${FLPDF_PROGNAME:-qpdf}"

if [[ -n "${FLPDF_QTEST_NORMALIZE:-}" && -r "${FLPDF_QTEST_NORMALIZE}" ]]; then
    if [[ /dev/stdout -ef /dev/stderr ]]; then
        set -o pipefail
        "${FLPDF_CLI_BIN}" "$@" 2>&1 | sed -f "${FLPDF_QTEST_NORMALIZE}"
        exit "${PIPESTATUS[0]}"
    fi

    # Distinct destinations: normalize stderr through a named pipe so the
    # filter can be waited on explicitly. `wait` alone does not reliably
    # drain a process substitution, and a filter still writing when the
    # shim exits loses diagnostics qtest is about to compare.
    normalize_dir="$(mktemp -d)"
    trap 'rm -rf "${normalize_dir}"' EXIT
    mkfifo "${normalize_dir}/stderr"
    sed -u -f "${FLPDF_QTEST_NORMALIZE}" < "${normalize_dir}/stderr" >&2 &
    normalize_pid=$!
    "${FLPDF_CLI_BIN}" "$@" 2> "${normalize_dir}/stderr"
    rc=$?
    wait "${normalize_pid}"
    exit "${rc}"
fi

exec "${FLPDF_CLI_BIN}" "$@"
